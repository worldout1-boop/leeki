rules_version = '2';

// 관리부 통합 업무일지 — Firestore 보안 규칙
// Firebase 콘솔 › Firestore Database › 규칙 탭에 이 파일 내용을 통째로 붙여 넣고 [게시]를 누르세요.
//
// · 로그인 + 이메일 인증을 마친 사람 중, 업무일지 설정의 '접속 허용 이메일'에 있는 사람만 읽고 쓸 수 있습니다.
// · 처음 한 번은 맨 먼저 로그인한 사람이 '관리자로 지정'을 눌러 관리자가 됩니다. (배포 직후 바로 진행하세요)
// · 이메일 주소는 이 파일이 아니라 데이터베이스(app/members 문서)에 저장되므로 공개 저장소에 올려도 됩니다.
// · 사진·서류(올린 파일) 삭제는 관리자만 할 수 있습니다. 다른 구성원은 '삭제 요청'(delreq)을 보냅니다.
// · 비공개 업무(priv/{uid})는 본인만 읽고 쓸 수 있습니다. 관리자도 볼 수 없습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function membersPath() {
      return /databases/$(database)/documents/app/members;
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function members() {
      return get(membersPath()).data;
    }
    function isAdmin() {
      return signedIn() && myEmail() in members().admins;
    }
    function isMember() {
      return signedIn()
        && (myEmail() in members().emails || myEmail() in members().admins);
    }

    // 접속 허용 목록 — 관리자만 수정, 처음 한 번만 '관리자로 지정' 가능
    match /app/members {
      allow get: if signedIn() && (!exists(membersPath()) || isMember());
      allow list: if false;
      allow create: if signedIn()
        && !exists(membersPath())
        && request.resource.data.admins == [myEmail()]
        && request.resource.data.emails == [myEmail()];
      allow update: if isAdmin()
        && request.resource.data.admins is list
        && request.resource.data.emails is list
        && myEmail() in request.resource.data.admins;
      allow delete: if false;
    }

    // 부서 설정 — 모두 읽기, 관리자만 수정
    match /app/config {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 직원 명단
    match /staff/{staffId} {
      allow read, write: if isMember();
    }

    // 업무 · 특이사항 · 보고서 종합의견
    match /wl/{rest=**} {
      allow read, write: if isMember();
    }

    // 열람 제한 서류를 볼 수 있는 사람: 관리자 + 설정의 '열람 허용 이메일'
    function canViewRestricted() {
      return isAdmin()
        || (isMember() && myEmail() in members().get('viewers', []));
    }

    // 법정 업무 설정 — 모두 읽기, 관리자만 수정
    match /app/legal {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // 법정 업무 자동 등록 기록 — 구성원 누구나 (중복 등록 방지용)
    match /app/legalLog {
      allow read, write: if isMember();
    }

    // 현장 사진 (자동으로 줄인 사진을 문서에 저장 — 무료 요금제용)
    // 삭제는 관리자만. 단, 올린 사람이 올린 직후 30분 안에 업무 저장 전 '사진 빼기'를 할 때는 본인 삭제 허용
    match /photos/{photoId} {
      allow read: if isMember();
      allow create: if isMember()
        && ((request.resource.data.d is string && request.resource.data.d.size() < 1000000)
          || (request.resource.data.b is bytes && request.resource.data.b.size() < 1000000))
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && (!('ts' in request.resource.data) || request.resource.data.ts == request.time);
      allow delete: if isAdmin()
        || (isMember()
          && resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('ts', null) is timestamp
          && request.time < resource.data.ts + duration.value(30, 'm'));
      allow update: if false;
    }
    // 사진 미리보기 (작은 썸네일) — 본 사진이 지워진 뒤에만 구성원이 지울 수 있음
    match /thumbs/{photoId} {
      allow read: if isMember();
      allow delete: if isAdmin()
        || (isMember() && !exists(/databases/$(database)/documents/photos/$(photoId)));
      allow create: if isMember()
        && request.resource.data.b is bytes
        && request.resource.data.b.size() < 200000;
      allow update: if false;
    }

    // 회사 서류함 — 목록은 구성원 모두, 삭제·열람 제한 변경은 관리자만
    match /files/{fileId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update: if isMember()
        && (request.resource.data.get('restricted', false) == resource.data.get('restricted', false) || isAdmin())
        && (isAdmin() || request.resource.data.get('versions', []).size() >= resource.data.get('versions', []).size());
      allow delete: if isAdmin();

      // 파일 내용 (700KB 조각) — 열람 제한 서류는 허용된 사람만 읽기
      match /chunks/{chunkId} {
        allow get: if isMember()
          && (get(/databases/$(database)/documents/files/$(fileId)).data.get('restricted', false) != true
            || canViewRestricted());
        allow list: if false;
        allow create: if isMember()
          && request.resource.data.b is bytes
          && request.resource.data.b.size() <= 1000000;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // 삭제 요청 — 구성원은 자기 요청만 보고 만들고 취소, 관리자는 모두 보고 처리
    match /delreq/{reqId} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'open');
    }

    // 관리자 표시 이름 (삭제 요청 창에 '관리자(이름)'으로 표시)
    match /app/admin {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 비공개 업무·사진 — 본인만 (관리자 포함 다른 사람은 읽을 수 없음)
    match /priv/{uid}/{document=**} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
  }
}
