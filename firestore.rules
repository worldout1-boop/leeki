rules_version = '2';

// 관리부 통합 업무일지 — Firestore 보안 규칙
// Firebase 콘솔 › Firestore Database › 규칙 탭에 이 파일 내용을 통째로 붙여 넣고 [게시]를 누르세요.
//
// · 로그인 + 이메일 인증을 마친 사람 중, 업무일지 설정의 '접속 허용 이메일'에 있는 사람만 읽고 쓸 수 있습니다.
// · 처음 한 번은 맨 먼저 로그인한 사람이 '관리자로 지정'을 눌러 관리자가 됩니다. (배포 직후 바로 진행하세요)
// · 이메일 주소는 이 파일이 아니라 데이터베이스(app/members 문서)에 저장되므로 공개 저장소에 올려도 됩니다.
// · 사진 삭제는 관리자만 할 수 있습니다. 다른 구성원은 '삭제 요청'(delreq)을 보냅니다.
// · 자료실 서류·회사서식(각종서류 올리기)의 올리기·삭제·이름 바꾸기·폴더 정리는 자료 관리자(app/members.docmgr·docmgrU)와 관리자만 합니다.
//   올리기·삭제 기록(doclog)은 고칠 수 없고, 구성원 모두 읽어 알림으로 받습니다.
// · 비공개 업무(priv/{uid})는 본인만 읽고 쓸 수 있습니다. 관리자도 볼 수 없습니다.
// · 그룹웨어 소식(gw)은 구성원 모두 읽고, 기록은 관리자만 합니다.
// · 전자결재(appr)는 결재선·참조에 든 사람과 관리자만 볼 수 있습니다. 결재 서식·결재선 설정은 관리자만 고칩니다.
// · 회사서식(forms)은 구성원 모두 보고 인쇄·작성하며, 올리기·분류·삭제는 자료 관리자만 합니다.
// · 개인정보 자료(pii — 이력서·급여·주민등록번호 13자리 등이 든 사진·파일)는 구성원 누구나 올릴 수 있지만,
//   읽기·삭제는 app/members.pii 에 지정된 총괄 관리자만 할 수 있습니다. 올린 사람도 다시 볼 수 없습니다.

service cloud.firestore {
  match /databases/{database}/documents {

    function membersPath() {
      return /databases/$(database)/documents/app/members;
    }
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function members() {
      return get(membersPath()).data;
    }
    function isAdmin() {
      return signedIn() && myEmail() in members().admins;
    }
    function isMember() {
      return signedIn()
        && (myEmail() in members().emails || myEmail() in members().admins);
    }
    // 자료 관리자 — 각종서류 올리기(자료실·회사서식)에 올리기·삭제·이름 바꾸기·폴더 정리를 할 수 있는 사람
    //   app/members.docmgr(로그인 이메일)·docmgrU(로그인 uid) — 관리자 화면이 설정 › 자료 관리 권한에 맞춰 둠. 관리자는 항상 포함
    function isDocMgr() {
      return isAdmin() || (isMember()
        && (myEmail() in members().get('docmgr', []) || request.auth.uid in members().get('docmgrU', [])));
    }
    // 개인정보 자료를 볼 수 있는 사람: 관리자 중 app/members.pii 에 지정된 총괄 관리자
    function isPiiOwner() {
      return isAdmin() && myEmail() in members().get('pii', []);
    }

    // 접속 허용 목록 — 관리자만 수정, 처음 한 번만 '관리자로 지정' 가능
    match /app/members {
      allow get: if signedIn() && (!exists(membersPath()) || isMember());
      allow list: if false;
      allow create: if signedIn()
        && !exists(membersPath())
        && request.resource.data.admins == [myEmail()]
        && request.resource.data.emails == [myEmail()];
      allow update: if isAdmin()
        && request.resource.data.admins is list
        && request.resource.data.emails is list
        && myEmail() in request.resource.data.admins
        // 총괄 관리자(pii) 지정은 지금의 총괄 관리자만 바꿀 수 있음 (비어 있을 때만 관리자가 본인을 지정)
        && (request.resource.data.get('pii', []) == resource.data.get('pii', [])
          || myEmail() in resource.data.get('pii', [])
          || (resource.data.get('pii', []).size() == 0 && request.resource.data.get('pii', []) == [myEmail()]));
      allow delete: if false;
    }

    // 부서 설정 — 모두 읽기, 관리자만 수정
    match /app/config {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 직원 명단 — 로그인 이메일은 관리자만 바꾸고, 로그인 연결(uid)은 비어 있을 때 본인 것으로만 채울 수 있음
    match /staff/{staffId} {
      allow read, create, delete: if isMember();
      allow update: if isAdmin() || (isMember()
        && request.resource.data.get('email', '') == resource.data.get('email', '')
        && (request.resource.data.get('uid', '') == resource.data.get('uid', '')
          || (resource.data.get('uid', '') == '' && request.resource.data.get('uid', '') == request.auth.uid)));
    }

    // 업무 · 특이사항 · 보고서 종합의견
    match /wl/{rest=**} {
      allow read, write: if isMember();
    }

    // 열람 제한 서류를 볼 수 있는 사람: 관리자 + 설정의 '열람 허용 이메일'
    function canViewRestricted() {
      return isAdmin()
        || (isMember() && myEmail() in members().get('viewers', []));
    }

    // 조직도·업무분장 — 모두 읽기, 관리자만 수정 (매주 점검도 관리자 화면에서)
    match /app/org {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 법정 업무 설정 — 모두 읽기, 관리자만 수정
    match /app/legal {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // 법정 업무 자동 등록 기록 — 구성원 누구나 (중복 등록 방지용)
    match /app/legalLog {
      allow read, write: if isMember();
    }

    // 현장 사진 (자동으로 줄인 사진을 문서에 저장 — 무료 요금제용)
    // 삭제는 관리자만. 단, 올린 사람이 올린 직후 30분 안에 업무 저장 전 '사진 빼기'를 할 때는 본인 삭제 허용
    match /photos/{photoId} {
      allow read: if isMember();
      allow create: if isMember()
        && ((request.resource.data.d is string && request.resource.data.d.size() < 1000000)
          || (request.resource.data.b is bytes && request.resource.data.b.size() < 1000000))
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && (!('ts' in request.resource.data) || request.resource.data.ts == request.time);
      allow delete: if isAdmin()
        || (isMember()
          && resource.data.get('uid', '') == request.auth.uid
          && resource.data.get('ts', null) is timestamp
          && request.time < resource.data.ts + duration.value(30, 'm'));
      allow update: if false;
    }
    // 사진 미리보기 (작은 썸네일) — 본 사진이 지워진 뒤에만 구성원이 지울 수 있음
    match /thumbs/{photoId} {
      allow read: if isMember();
      allow delete: if isAdmin()
        || (isMember() && !exists(/databases/$(database)/documents/photos/$(photoId)));
      allow create: if isMember()
        && request.resource.data.b is bytes
        && request.resource.data.b.size() < 200000;
      allow update: if false;
    }

    // 자료실 — 보기는 구성원 모두, 올리기·고치기·삭제는 자료 관리자, 열람 제한 변경은 관리자만
    //   (구성원은 미리보기 그림(thumb)만 채울 수 있음)
    match /files/{fileId} {
      allow read: if isMember();
      allow create: if isDocMgr();
      allow update: if (isDocMgr()
          && (request.resource.data.get('restricted', false) == resource.data.get('restricted', false) || isAdmin()))
        || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thumb', 'thumbV']));
      allow delete: if isDocMgr();

      // 파일 내용 (700KB 조각) — 열람 제한 서류는 허용된 사람만 읽기
      match /chunks/{chunkId} {
        allow get: if isMember()
          && (get(/databases/$(database)/documents/files/$(fileId)).data.get('restricted', false) != true
            || canViewRestricted());
        allow list: if false;
        allow create: if isDocMgr()
          && request.resource.data.b is bytes
          && request.resource.data.b.size() <= 1000000;
        allow update: if false;
        allow delete: if isDocMgr();
      }
    }

    // 삭제 요청 — 구성원은 자기 요청만 보고 만들고 취소, 관리자는 모두 보고 처리
    match /delreq/{reqId} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isMember() && resource.data.uid == request.auth.uid && resource.data.status == 'open');
    }

    // 관리자 표시 이름 (삭제 요청 창에 '관리자(이름)'으로 표시)
    match /app/admin {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 그룹웨어 소식 — 구성원 모두 읽기, 관리자만 기록 (매시간 자동 확인이 관리자 계정 화면에서 요약을 적음)
    match /gw/{postId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    match /app/gw {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 정기 일정(월례조회·업무회의) 설정·날짜 변경 — 구성원 모두 읽기, 관리자만 수정
    match /app/sched {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 접속 요청 — 아직 허용되지 않은 사람이 본인 이메일로 요청, 관리자만 목록 보기·삭제
    match /joinreq/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.email == myEmail()
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.at is string && request.resource.data.at.size() <= 40;
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, delete: if isAdmin();
    }

    // 개인정보 자료 — 올리기는 구성원 누구나, 읽기·삭제는 총괄 관리자만
    match /pii/{id} {
      allow get, list: if isPiiOwner();
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.kind in ['photo', 'file']
        && request.resource.data.keys().hasOnly(['kind', 'name', 'type', 'size', 'n', 'th', 'why', 'src', 'title', 'site', 'path', 'at', 'by', 'byName', 'uid', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.why is list && request.resource.data.why.size() <= 6;
      allow update, delete: if isPiiOwner();

      // 내용 조각 (사진 0·미리보기 th, 파일 0,1,2…) — 한 번 쓰면 바꿀 수 없음
      match /c/{cid} {
        allow get, list: if isPiiOwner();
        allow create: if isMember()
          && ((request.resource.data.get('b', null) is bytes && request.resource.data.b.size() <= 1000000)
            || (request.resource.data.get('d', null) is string && request.resource.data.d.size() < 1000000));
        allow update: if false;
        allow delete: if isPiiOwner();
      }
    }

    // 전자결재 — 문서는 결재선·참조에 든 사람(uids)과 관리자만 읽기.
    // 내용(제목·본문·첨부)은 기안자만, 그것도 임시저장·회수·반려 상태일 때만 고칠 수 있음. 결재자·참조자는 결재·확인 기록만.
    match /appr/{id} {
      allow read: if isMember() && (isAdmin() || request.auth.uid in resource.data.uids);
      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status in ['draft', 'run', 'done'];
      allow update: if isMember()
        && request.resource.data.by == resource.data.by
        && ((resource.data.by == request.auth.uid && resource.data.status in ['draft', 'back', 'no'])
          || ((isAdmin() || request.auth.uid in resource.data.uids)
            && request.resource.data.uids.hasAll(resource.data.uids)
            && request.resource.data.title == resource.data.title
            && request.resource.data.body == resource.data.body
            && request.resource.data.files == resource.data.files));
      allow delete: if isAdmin()
        || (isMember() && resource.data.by == request.auth.uid && resource.data.status in ['draft', 'back']);

      // 첨부 내용 (700KB 조각) — 문서를 볼 수 있는 사람만 읽기, 기안자만 올리기
      match /f/{cid} {
        allow get: if isMember()
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/appr/$(id)).data.uids);
        allow list: if false;
        allow create: if isMember()
          && get(/databases/$(database)/documents/appr/$(id)).data.by == request.auth.uid
          && request.resource.data.b is bytes && request.resource.data.b.size() <= 1000000;
        allow update: if false;
        allow delete: if isAdmin()
          || (isMember() && get(/databases/$(database)/documents/appr/$(id)).data.by == request.auth.uid);
      }
    }
    // 전자결재 문서번호 (연도별 1씩 증가)
    match /apprseq/{year} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.n == 1;
      allow update: if isMember() && request.resource.data.n == resource.data.n + 1;
    }
    // 결재 서식 — 모두 읽기, 관리자만 올리기·고치기
    match /apprtpl/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
      match /f/{cid} {
        allow read: if isMember();
        allow write: if isAdmin();
      }
    }
    // 폴더 목록 — 자료실 폴더·회사서식 빈 폴더 목록은 자료 관리자가 만들고 고침
    match /app/docdirs {
      allow read: if isMember();
      allow write: if isDocMgr();
    }
    match /app/formdirs {
      allow read: if isMember();
      allow write: if isDocMgr();
    }
    // 회사서식 — 구성원 모두 읽기(미리보기·인쇄·내려받기·작성), 올리기·분류·고치기·삭제는 자료 관리자
    match /forms/{id} {
      allow read: if isMember();
      allow write: if isDocMgr();
      match /f/{cid} {
        allow read: if isMember();
        allow write: if isDocMgr();
      }
      match /h/{cid} {
        allow read: if isMember();
        allow write: if isDocMgr();
      }
    }
    // 올리기·삭제 기록 — 구성원 모두 읽기(알림), 자료 관리자가 본인 이름으로 남기기만, 고치기 불가
    match /doclog/{id} {
      allow read: if isMember();
      allow create: if isDocMgr()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['act', 'kind', 'id', 'title', 'v', 'n', 'why', 'by', 'byName', 'uid', 'at'])
        && request.resource.data.act in ['up', 'ver', 'del', 'vdel']
        && request.resource.data.kind in ['file', 'form']
        && request.resource.data.title is string && request.resource.data.title.size() <= 120
        && request.resource.data.at is string;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // 결재선 설정 — 모두 읽기, 관리자만 수정
    match /app/appr {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // 비공개 업무·사진 — 본인만 (관리자 포함 다른 사람은 읽을 수 없음)
    match /priv/{uid}/{document=**} {
      allow read, write: if isMember() && request.auth.uid == uid;
    }
  }
}
